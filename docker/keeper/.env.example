# The spDEX keeper's settings: copy this file to .env and fill it in.
# No secret goes in this file: the key and the endpoint URLs are files in secrets/.
# Everything not here has a default, listed under "Advanced settings" in docs/KEEPER.md.

# Your user and group ids (`id -u`, `id -g`), so the keeper can read secrets/ without root.
KEEPER_UID=1000
KEEPER_GID=1000

# The Ethereum endpoint to read from (required): its URL goes in the file secrets/rpc_url.
# The keeper's hot key (required): 32 bytes of hex in the file secrets/keeper_key.
# A private send endpoint (optional): its URL in secrets/send_url; leave that file empty for none.

# Where buy fees are paid: a cold address you control (empty: the keeper's own address).
SPDEX_KEEPER_REWARD_TO=

# Optional subsidy for buys whose fee doesn't cover their gas (default: none). One operator's choice:
# SPDEX_KEEPER_MAX_LOSS_PER_BUY_ETH=0.00006
# SPDEX_KEEPER_MAX_LOSS_PER_VAULT_PER_DAY_ETH=0.0001
# SPDEX_KEEPER_MAX_SUBSIDY_PER_OWNER_DAY_ETH=0.0002
# SPDEX_KEEPER_MAX_LOSS_PER_DAY_ETH=0.02

# Where its state, logs and heartbeat live: the Docker volume keeper-data, or a directory you made, such as ./data.
KEEPER_DATA=keeper-data
