# The spDEX keeper's settings: copy this file to .env and fill it in.
# No secret goes in this file: the key and the endpoint URLs are files in secrets/.
# Everything not here has a default, listed under "Advanced settings" in docs/KEEPER.md.

# Your user and group ids (`id -u`, `id -g`), so the keeper can read secrets/ without root.
KEEPER_UID=1000
KEEPER_GID=1000

# The Ethereum endpoint to read from (required): its URL goes in the file secrets/rpc_url.
# The keeper's hot key (required): 32 bytes of hex in the file secrets/keeper_key.
# A private send endpoint (optional): its URL in secrets/send_url; leave that file empty for none.

# Where buy fees are paid: a cold address you control (empty: the keeper's own address). Best a wallet kept
# for the SPX, not your main one: every batch names it beside the keeper's hot key, in public. To be paid
# inside community windows — SPX holders' first claim on each buy — it must be an ordinary account
# (not a contract) that held 690 SPX at the end of a recent block, proven once a month, and still holds
# 690 SPX. Community keepers make other people's buys and are paid for each one; holding 690 SPX is the
# entry bar. Without that it is paid only for buys after their window, when anyone may make them.
SPDEX_KEEPER_REWARD_TO=

# Prove REWARD_TO's SPX to the registry before its proof lapses, from the keeper's hot key (default 0: off).
# About 660,000 gas, once a month; the SPX never leaves REWARD_TO. Either way the keeper logs when the
# proof lapses. You can prove from the app instead ("Prove another address").
# SPDEX_KEEPER_PROVE=1

# Warn when the hot key's ether covers fewer days of sends than this, at its last week's spend (default 7;
# 0 never warns). With a cold REWARD_TO the keeper earns nothing back into its hot key: top it up by hand.
# SPDEX_KEEPER_MIN_RUNWAY_DAYS=7

# Optional subsidy for buys whose fee doesn't cover their gas (default: none). One operator's choice:
# SPDEX_KEEPER_MAX_LOSS_PER_BUY_ETH=0.00006
# SPDEX_KEEPER_MAX_LOSS_PER_VAULT_PER_DAY_ETH=0.0001
# SPDEX_KEEPER_MAX_SUBSIDY_PER_OWNER_DAY_ETH=0.0002
# SPDEX_KEEPER_MAX_LOSS_PER_DAY_ETH=0.02

# Where its state, logs and heartbeat live: the Docker volume keeper-data, or a directory you made, such as ./data.
KEEPER_DATA=keeper-data
